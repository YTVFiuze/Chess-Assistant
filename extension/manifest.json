{
  "manifest_version": 3,
  "name": "Chess.com Move Assistant",
  "version": "1.0.2",
  "description": "AI-powered chess move suggestions with brilliant move detection for chess.com",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": [
        "stockfish-wrapper.js",
        "board-detector.js",
        "arrow-drawer.js",
        "content-new.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chess Move Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
